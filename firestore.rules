rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function groupDoc(gid) { return get(/databases/$(database)/documents/groups/$(gid)).data; }
    // The group's organizer is whoever created it.
    function isOwner(gid) { return signedIn() && groupDoc(gid).ownerUid == request.auth.uid; }
    function notDrawn(gid) { return groupDoc(gid).drawn != true; }
    function shortText(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function groupFields() { return ['ownerUid', 'ev', 'budget', 'kidBudget', 'date', 'drawn', 'drawnAt', 'createdAt', 'virtual']; }

    // Each signed-in person's own list of groups. Only they can see it.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /groups/{gid} {
      // Anyone with the group's link can see its name, budget, date and whether names are drawn.
      allow get: if true;
      allow list: if false;
      // Anyone signed in with Google can start a group and becomes its organizer.
      allow create: if signedIn()
        && gid.size() >= 10
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.drawn == false
        && request.resource.data.keys().hasOnly(groupFields())
        && shortText(request.resource.data.ev, 60);
      // Only the organizer can change it, and nobody can change who the organizer is.
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.keys().hasOnly(groupFields());
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // The group photo. Everyone with the link sees it; only the organizer changes it.
      match /public/{docId} {
        allow read: if true;
        allow delete: if isOwner(gid);
        allow create, update: if isOwner(gid)
          && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
          && request.resource.data.data is string
          && request.resource.data.data.size() < 900000
          && request.resource.data.data.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
      }

      // Organizer-only settings ("who shouldn't draw whom").
      match /admin/{docId} {
        allow read, write: if isOwner(gid);
      }

      // One document per person, keyed by their secret personal link.
      match /people/{secret} {
        allow get: if true;
        allow list, delete: if isOwner(gid);
        allow create: if notDrawn(gid)
          && secret.size() >= 20
          && request.resource.data.keys().hasOnly(['name', 'wishId', 'rosterId', 'joinedAt'])
          && shortText(request.resource.data.name, 40);
        allow update: if notDrawn(gid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kidVolunteer'])
          && request.resource.data.kidVolunteer is bool;

        // Kids a parent adds. Reachable only through the parent's secret link.
        match /kids/{kidId} {
          allow read: if true;
          allow delete: if isOwner(gid);
          allow create: if notDrawn(gid)
            && exists(/databases/$(database)/documents/groups/$(gid)/people/$(secret))
            && request.resource.data.keys().hasOnly(['name', 'wishId', 'rosterId', 'createdAt'])
            && shortText(request.resource.data.name, 40);
        }
      }

      // Wishlists, keyed by a second secret that only the person and their Secret Santa learn.
      match /wishes/{wishId} {
        allow get: if true;
        allow list, delete: if isOwner(gid);
        allow create: if notDrawn(gid)
          && wishId.size() >= 20
          && request.resource.data.keys().hasOnly(['name', 'wishlist'])
          && shortText(request.resource.data.name, 40)
          && request.resource.data.wishlist is string
          && request.resource.data.wishlist.size() <= 4000;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wishlist'])
          && request.resource.data.wishlist is string
          && request.resource.data.wishlist.size() <= 4000;
      }

      // Mailing addresses for virtual exchanges, keyed like wishlists: only the person,
      // their Secret Santa (after the draw) and the organizer know the key.
      match /addresses/{wishId} {
        allow get: if true;
        allow list, delete: if isOwner(gid);
        allow create, update: if wishId.size() >= 20
          && existsAfter(/databases/$(database)/documents/groups/$(gid)/wishes/$(wishId))
          && request.resource.data.keys().hasOnly(['fullName', 'careOf', 'line1', 'line2', 'city', 'state', 'zip', 'intl', 'verified', 'updatedAt'])
          && shortText(request.resource.data.fullName, 80)
          && request.resource.data.get('careOf', '') is string && request.resource.data.get('careOf', '').size() <= 80
          && request.resource.data.get('line1', '') is string && request.resource.data.get('line1', '').size() <= 120
          && request.resource.data.get('line2', '') is string && request.resource.data.get('line2', '').size() <= 120
          && request.resource.data.get('city', '') is string && request.resource.data.get('city', '').size() <= 60
          && request.resource.data.get('state', '') is string && request.resource.data.get('state', '').size() <= 40
          && request.resource.data.get('zip', '') is string && request.resource.data.get('zip', '').size() <= 12
          && request.resource.data.get('intl', '') is string && request.resource.data.get('intl', '').size() <= 400
          && request.resource.data.verified is bool;
      }

      // Optional phone numbers for the organizer's group texts. Keyed by the person's
      // secret link, so only they (and the organizer) can reach theirs.
      match /phones/{secret} {
        allow get: if true;
        allow list: if isOwner(gid);
        allow delete: if isOwner(gid) || exists(/databases/$(database)/documents/groups/$(gid)/people/$(secret));
        allow create, update: if existsAfter(/databases/$(database)/documents/groups/$(gid)/people/$(secret))
          && request.resource.data.keys().hasOnly(['phone', 'updatedAt'])
          && request.resource.data.phone is string
          && request.resource.data.phone.matches('[+][0-9]{7,15}');
      }

      // Public list of names in the group. A child's entry is keyed by their name,
      // so the same child can't be added twice.
      match /roster/{rosterId} {
        allow read: if true;
        allow delete: if isOwner(gid);
        allow create: if notDrawn(gid)
          && request.resource.data.keys().hasOnly(['name', 'joinedAt', 'kid', 'parentName'])
          && shortText(request.resource.data.name, 40);
      }

      // Each person's match, keyed by their secret link. Only the organizer writes these.
      match /matches/{secret} {
        allow get: if true;
        allow list, write: if isOwner(gid);
      }
    }
  }
}
